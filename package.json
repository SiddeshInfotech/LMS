{
  "name": "ai-and-mechatronix-lab",
  "private": true,
  "version": "1.1.0",
  "description": "Secure Enterprise Learning Management System with Hardware Locking",
  "author": "Siddesh Global Education Society",
  "type": "module",
  "main": "main-loader.cjs",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "electron-start": "electron .",
    "dev-start": "electron main.cjs",
    "build": "vite build",
    "rebuild": "npx rimraf build && npx node-gyp rebuild",
    "postbuild:video": "node tools/encrypt_assets.cjs",
    "compile:fortress": "electron tools/compile_fortress.cjs",
    "package-linux": "npm run rebuild && npm run build && npm run postbuild:video && npm run compile:fortress && electron-builder --linux --x64",
    "linux-setup": "sudo bash setup_linux.sh",
    "linux-run": "npm run compile:fortress && export ELECTRON_DISABLE_SANDBOX=1 && ./node_modules/.bin/electron . --no-sandbox --disable-gpu --disable-dev-shm-usage"
  },
  "build": {
    "appId": "com.lms.app",
    "productName": "LMS",
    "files": [
      "dist/**/*",
      "build/Release/recorder_detect.node",
      "main.jsc",
      "main-loader.cjs",
      "preload.jsc",
      "preload-loader.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/Release/recorder_detect.node",
        "to": "recorder_detect.node"
      },
      {
        "from": "resources/encrypted",
        "to": "encrypted"
      },
      "tools/public.pem",
      "tools/get_hwid.cjs",
      "tools/master_key.txt",
      "LICENSE_MANAGEMENT_SOP.md",
      {
        "from": "registry",
        "to": "registry"
      }
    ],

    "directories": {
      "output": "dist_electron",
      "buildResources": "resources"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "LMS Admin",
      "executableName": "lms-secure",
      "asarUnpack": [
        "**/*.jsc",
        "**/*.node"
      ],
      "executableArgs": [
        "--no-sandbox"
      ]
    },


    "deb": {
      "afterInstall": "scripts/after-install.sh",
      "afterRemove": "scripts/after-remove.sh"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "lucide-react": "^1.7.0",
    "node-addon-api": "^8.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "bytenode": "^1.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.21"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
